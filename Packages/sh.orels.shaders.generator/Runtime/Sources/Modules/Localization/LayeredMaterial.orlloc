# Localization for the LayeredMaterial module
# Source: Modules/LayeredMaterial.orlsource
#
# `@[Prop]` references copy the same field of the target property,
# in the same language (falling back to english).
# Layers 2-4 reuse the names of the Layer 1 properties.

[UI_LayeredMatHeader]
name.en = Layers
name.ja = レイヤー

[_LayeredMatLayersCount]
name.en = Layer Count
name.ja = レイヤー数
tooltip.en = The amount of layers used
tooltip.ja = 使用するレイヤーの数

[_LMMaskingType]
name.en = Mask Type
name.ja = マスクタイプ
tooltip.en = Controls what is used for masking
tooltip.ja = マスキングに使用するものを制御

[_LMMaskTex]
name.en = Mask Texture
name.ja = マスクテクスチャ
tooltip.en = This will be used to mask the layers by color
tooltip.ja = 色によってレイヤーをマスクするために使用されます

[_LMMaskTexUV]
name.en = UV Set
name.ja = UVセット
tooltip.en = Selects the UV set used for sampling the Mask Texture
tooltip.ja = マスクテクスチャのサンプリングに使用するUVセットを選択

[_LMMaskDebugging]
name.en = Mask Debugging
name.ja = マスクデバッグ
tooltip.en = Displays the mask values on the mesh based on selected Mask Type
tooltip.ja = 選択したマスクタイプに基づいてメッシュ上にマスク値を表示

[_LMMaskDebuggingChannel]
name.en = Debug Channel
name.ja = デバッグチャンネル
tooltip.en = Controls which channel to display during debugging
tooltip.ja = デバッグ中に表示するチャンネルを制御

[UI_LMLayerBaseHeader]
name.en = Base Layer
name.ja = ベースレイヤー

[_LMLayerBaseColor]
name.en = Main Color
name.ja = メインカラー
tooltip.en = Main Tint Color
tooltip.ja = メインの色合い

[_LMLayerBaseUV]
name.en = UV Set
name.ja = UVセット
tooltip.en = Selects the UV set used for sampling all the Base Layer textures
tooltip.ja = すべてのベースレイヤーテクスチャのサンプリングに使用するUVセットを選択

[_LMLayerBaseMainTex]
name.en = Albedo
name.ja = アルベド

[_LMLayerBaseMaskMap]
name.en = Masks
name.ja = マスク
tooltip.en = Texture containing Metallic, Smoothness, and AO maps. Default channel layout is Red: Metallic, Green: AO, Alpha: Smoothness. Can be adjusted using a remapper below
tooltip.ja = メタリック、スムースネス、AOマップを含むテクスチャ。デフォルトのチャンネル配置は赤:メタリック、緑:AO、アルファ:スムースネス。下のリマッパーで調整可能

[_LMLayerBaseMetalChannel]
name.en = Metal
name.ja = メタル
tooltip.en = Selects a channel containing Metal values
tooltip.ja = メタル値を含むチャンネルを選択

[_LMLayerBaseAOChannel]
name.en = AO
name.ja = AO
tooltip.en = Selects a channel containing AO values
tooltip.ja = AO値を含むチャンネルを選択

[_LMLayerBaseSmoothChannel]
name.en = Smooth
name.ja = スムース
tooltip.en = Selects a channel containing Smoothness values
tooltip.ja = スムースネス値を含むチャンネルを選択

[_LMLayerBaseSmoothness]
name.en = Smoothness
name.ja = スムースネス
tooltip.en = Controls global smoothness level, uses this value across the whole material
tooltip.ja = グローバルなスムースネスレベルを制御し、マテリアル全体でこの値を使用

[_LMLayerBaseRoughnessMode]
name.en = Roughness Mode
name.ja = ラフネスモード
tooltip.en = Flips the channel value. If your texture contains Roughness instead of Smoothness - you should use this option
tooltip.ja = チャンネル値を反転します。テクスチャがスムースネスの代わりにラフネスを含む場合は、このオプションを使用してください

[_LMLayerBaseMetallic]
name.en = Metallic
name.ja = メタリック
tooltip.en = Controls global metalness level, uses this value across the whole material
tooltip.ja = グローバルなメタルネスレベルを制御し、マテリアル全体でこの値を使用

[_LMLayerBaseMetallicRemap]
name.en = Metallic Remap
name.ja = メタリックリマップ
tooltip.en = Allows you to adjust the range of metalness values of the provided Metal map
tooltip.ja = 提供されたメタルマップのメタルネス値の範囲を調整できます

[_LMLayerBaseSmoothnessRemap]
name.en = Smoothness Remap
name.ja = スムースネスリマップ
tooltip.en = Allows you to adjust the range of smoothness values of the provided Smoothness map
tooltip.ja = 提供されたスムースネスマップのスムースネス値の範囲を調整できます

[_LMLayerBaseOcclusionStrength]
name.en = AO Strength
name.ja = AO強度
tooltip.en = Controls the strength of the provided Ambient Occlusion map
tooltip.ja = 提供されたアンビエントオクルージョンマップの強度を制御

[_LMLayerBaseBumpMap]
name.en = Normal Map
name.ja = ノーマルマップ

[_LMLayerBaseBumpScale]
name.en = Normal Map Scale
name.ja = ノーマルマップスケール

[_LMLayerBaseFlipBumpY]
name.en = Flip Y (UE Mode)
name.ja = Y反転（UEモード）
tooltip.en = Flips the green channel of the normal map for DirectX-style normal maps, which are commonly found in something like Unreal Engine assets. If your normal map looks "upside-down" - you should try this option
tooltip.ja = Unreal Engineアセットなどで一般的に見られるDirectXスタイルのノーマルマップのために、ノーマルマップの緑チャンネルを反転します。ノーマルマップが「上下逆」に見える場合は、このオプションを試してください

