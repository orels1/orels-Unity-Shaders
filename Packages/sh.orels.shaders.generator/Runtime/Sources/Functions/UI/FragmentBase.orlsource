%Properties()
{
    UI_UnityUIHeader("# Unity UI", Int) = 0
    UI_UnityUINote("> These properties are used by Unity's UI system directly and you generally aren't meant to mess witht them", Int) = 0
    _Color ("Tint", Color) = (1,1,1,1)
    _StencilComp ("Stencil Comparison", Float) = 8
    _Stencil ("Stencil ID", Float) = 0
    _StencilOp ("Stencil Operation", Float) = 0
    _StencilWriteMask ("Stencil Write Mask", Float) = 255
    _StencilReadMask ("Stencil Read Mask", Float) = 255

    _ColorMask ("Color Mask", Float) = 15

    [Toggle(UNITY_UI_ALPHACLIP)] _UseUIAlphaClip ("Use Alpha Clip", Float) = 0
}

%ShaderTags()
{
    "Queue" = "Transparent" "RenderType" = "Transparent" "IgnoreProjector"="True" "PreviewType"="Plane" "CanUseSpriteAtlas"="True"
}

%ShaderModifiers()
{
    Stencil
    {
        Ref [_Stencil]
        Comp [_StencilComp]
        Pass [_StencilOp]
        ReadMask [_StencilReadMask]
        WriteMask [_StencilWriteMask]
    }

    Cull Off
    Lighting Off
    ZWrite Off
    ZTest [unity_GUIZTestMode]
    Blend SrcAlpha OneMinusSrcAlpha
    ColorMask [_ColorMask]
}

%Variables()
{

    half4 _Color;
    fixed4 _TextureSampleAdd;
    float4 _ClipRect;

    #if !defined(NEED_FLOAT4_UV)
    float2 GLOBAL_uvArray[UV_CHANNEL_COUNT];
    #else
    float4 GLOBAL_uvArray[UV_CHANNEL_COUNT];
    #endif
}

%ShaderFeatures()
{
    #pragma multi_compile_local _ UNITY_UI_CLIP_RECT
    #pragma multi_compile_local _ UNITY_UI_ALPHACLIP
}

%ShaderDefines()
{
    #define ORL_LIGHTING_MODEL_UI

    #if defined(UNITY_PBS_USE_BRDF2) || defined(SHADER_API_MOBILE)
      #define PLAT_QUEST
    #else
      #ifdef PLAT_QUEST
        #undef PLAT_QUEST
      #endif
    #endif

    #if defined(NEED_UV4)
        #define UV_CHANNEL_COUNT 5
    #elif defined(NEED_UV5)
        #define UV_CHANNEL_COUNT 6
    #elif defined(NEED_UV6)
        #define UV_CHANNEL_COUNT 7
    #elif defined(NEED_UV7)
        #define UV_CHANNEL_COUNT 8
    #else
        #define UV_CHANNEL_COUNT 4
    #endif

    #define GLOBAL_UVS_PRESENT

    #include "UnityUI.cginc"
}

%Fragment("UIFragmentSetup", -99999)
{
    void UIFragmentSetup(MeshData d)
    {
        // Populate UVs for easier access
        GLOBAL_uvArray[0] = d.uv0;
        GLOBAL_uvArray[1] = d.uv1;
        GLOBAL_uvArray[2] = d.uv2;
        GLOBAL_uvArray[3] = d.uv3;

        #if defined(NEED_UV4)
            GLOBAL_uvArray[4] = d.uv4;
        #elif defined(NEED_UV5)
            GLOBAL_uvArray[5] = d.uv5;
        #elif defined(NEED_UV6)
            GLOBAL_uvArray[6] = d.uv6;
        #elif defined(NEED_UV7)
            GLOBAL_uvArray[7] = d.uv7;
        #endif
    }
}

%FragmentBase("FragmentBase")
{
    void FragmentBase(MeshData d, SurfaceData o, inout half4 FinalColor)
    {
        o.Albedo += _TextureSampleAdd;
        o.Albedo *= _Color.rgb;
        o.Alpha *= _Color.a;
        #ifdef UNITY_UI_CLIP_RECT
            o.Alpha  *= UnityGet2DClipping(d.worldSpacePosition.xy, _ClipRect);
        #endif

        #ifdef UNITY_UI_ALPHACLIP
            clip(o.Alpha  - 0.001);
        #endif
        FinalColor = half4(o.Albedo.rgb + o.Emission, o.Alpha);
    }
}
