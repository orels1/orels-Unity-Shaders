%Properties()
{
    _BakerChannel("Baker Channel", Int) = 0
}

%ShaderDefines()
{
    #define ORL_LIGHTING_MODEL_PBR

    #if defined(UNITY_PBS_USE_BRDF2) || defined(SHADER_API_MOBILE)
        #define PLAT_QUEST
    #else
        #ifdef PLAT_QUEST
            #undef PLAT_QUEST
        #endif
    #endif

    #define ORL_MIN_ROUGHNESS 0.002025
    #if defined(PLAT_QUEST)
        #define ORL_MIN_ROUGHNESS 0.007921
    #endif

    #if !defined(SHADING_MODE_DEFAULT) && !defined(SHADING_MODE_CLOTH)
        #define SHADING_MODE_DEFAULT
    #endif

    #define NEED_SCREEN_POS
    #if !defined(NEED_FRAGMENT_IN_SHADOW)
        #define NEED_FRAGMENT_IN_SHADOW
    #endif

    #define NEED_SCREEN_POS

    #if defined(NEED_UV4)
        #define UV_CHANNEL_COUNT 5
    #elif defined(NEED_UV5)
        #define UV_CHANNEL_COUNT 6
    #elif defined(NEED_UV6)
        #define UV_CHANNEL_COUNT 7
    #elif defined(NEED_UV7)
        #define UV_CHANNEL_COUNT 8
    #else
        #define UV_CHANNEL_COUNT 4
    #endif

    #define GLOBAL_UVS_PRESENT
}

%Variables()
{
    int _BakerChannel;
    float4 __MapBaker_MainTex_ST;

    #if !defined(NEED_FLOAT4_UV)
    float2 GLOBAL_uvArray[UV_CHANNEL_COUNT];
    #else
    float4 GLOBAL_uvArray[UV_CHANNEL_COUNT];
    #endif
}

%Fragment("MapBakerFragmentSetup", -99999)
{
    void MapBakerFragmentSetup(MeshData d)
    {
        // Populate UVs for easier access
        GLOBAL_uvArray[0] = d.uv0;
        GLOBAL_uvArray[1] = d.uv1;
        GLOBAL_uvArray[2] = d.uv2;
        GLOBAL_uvArray[3] = d.uv3;

        #if defined(NEED_UV4)
            GLOBAL_uvArray[4] = d.uv4;
        #elif defined(NEED_UV5)
            GLOBAL_uvArray[5] = d.uv5;
        #elif defined(NEED_UV6)
            GLOBAL_uvArray[6] = d.uv6;
        #elif defined(NEED_UV7)
            GLOBAL_uvArray[7] = d.uv7;
        #endif
    }
}


%Fragment("MapBakerBlitWorkaroundFragment", -9999)
{
    void MapBakerBlitWorkaroundFragment()
    {
        // workaround for tiling being broken in the map baker
        _MainTex_ST = __MapBaker_MainTex_ST;
    }
}

%FragmentBase("FragmentBase")
{
    void FragmentBase(MeshData d, FragmentData i, SurfaceData o, inout half4 FinalColor)
    {
        FinalColor.a = 1;
        switch (_BakerChannel)
        {
            case 0:
            {
                FinalColor.rgb = o.Albedo;
                return;
            }
            case 1:
            {
                FinalColor.r = o.Metallic;
                FinalColor.g = o.Occlusion;
                FinalColor.b = 1;
                FinalColor.a = o.Smoothness;
                return;
            }
            case 2:
            {
                float2 reconvertedNormal = o.Normal;
                reconvertedNormal = reconvertedNormal * 0.5 + 0.5;
                FinalColor.r = reconvertedNormal.x;
                FinalColor.g = reconvertedNormal.y;
                FinalColor.b = 1;
                FinalColor.a = 1;
                return;
            }
        }
    }
}
